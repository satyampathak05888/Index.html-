<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Satyam Pathak — Builder &amp; Writer</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,500&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#132323;
    --teal:#1B3A3A;
    --teal-deep:#0F2626;
    --parchment:#F1EDE3;
    --paper:#FAF8F3;
    --mustard:#D9A441;
    --mustard-soft:#EBCB8C;
    --rule: rgba(19,35,35,0.14);
    --max: 1100px;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--paper);
    color:var(--ink);
    font-family:'IBM Plex Sans', sans-serif;
    line-height:1.55;
    -webkit-font-smoothing:antialiased;
  }
  ::selection{ background:var(--mustard-soft); color:var(--teal-deep); }
  a{ color:inherit; }

  .wrap{ max-width:var(--max); margin:0 auto; padding:0 32px; }

  /* ---------- NAV ---------- */
  header.nav{
    position:sticky; top:0; z-index:50;
    background:rgba(250,248,243,0.88);
    backdrop-filter: blur(8px);
    border-bottom:1px solid var(--rule);
  }
  .nav-inner{
    max-width:var(--max); margin:0 auto; padding:18px 32px;
    display:flex; align-items:center; justify-content:space-between;
  }
  .nav-mark{
    font-family:'IBM Plex Mono', monospace;
    font-size:14px; letter-spacing:0.02em;
    display:flex; align-items:baseline; gap:8px;
  }
  .nav-mark .dot{ color:var(--mustard); }
  .nav-links{ display:flex; gap:28px; list-style:none; font-size:14px; }
  .nav-links a{ text-decoration:none; opacity:0.75; transition:opacity .15s; }
  .nav-links a:hover{ opacity:1; }
  .nav-links a:focus-visible, a:focus-visible{ outline:2px solid var(--mustard); outline-offset:3px; }

  /* ---------- HERO ---------- */
  .hero{
    padding:96px 0 72px;
    border-bottom:1px solid var(--rule);
    position:relative;
    overflow:hidden;
  }
  .hero-eyebrow{
    font-family:'IBM Plex Mono', monospace;
    font-size:13px; color:var(--teal);
    display:flex; align-items:center; gap:10px;
    margin-bottom:28px;
  }
  .hero-eyebrow::before{
    content:""; width:26px; height:1px; background:var(--mustard);
  }
  h1.hero-title{
    font-family:'Fraunces', serif;
    font-weight:600;
    font-size: clamp(44px, 7vw, 84px);
    line-height:0.98;
    letter-spacing:-0.01em;
    max-width:900px;
  }
  h1.hero-title .accent{
    font-style:italic; font-weight:500; color:var(--teal);
  }
  .hero-split{
    margin-top:44px;
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:0;
    border:1px solid var(--rule);
  }
  .hero-cell{
    padding:26px 28px;
  }
  .hero-cell + .hero-cell{ border-left:1px solid var(--rule); }
  .hero-cell .label{
    font-family:'IBM Plex Mono', monospace;
    font-size:12px; text-transform:uppercase; letter-spacing:0.08em;
    color:var(--mustard); margin-bottom:10px; display:block;
  }
  .hero-cell.code{ background:var(--teal); color:var(--parchment); }
  .hero-cell.code .label{ color:var(--mustard-soft); }
  .hero-cell.code p{ font-family:'IBM Plex Mono', monospace; font-size:14.5px; }
  .hero-cell.copy p{ font-family:'Fraunces', serif; font-style:italic; font-size:19px; color:var(--teal-deep); }
  .hero-contact{
    margin-top:28px; display:flex; gap:24px; flex-wrap:wrap;
    font-family:'IBM Plex Mono', monospace; font-size:13.5px;
  }
  .hero-contact a{ text-decoration:none; border-bottom:1px solid var(--rule); padding-bottom:2px; }
  .hero-contact a:hover{ border-color:var(--mustard); }

  /* ---------- SECTION HEADER ---------- */
  .section{ padding:72px 0; border-bottom:1px solid var(--rule); }
  .section-head{
    display:flex; align-items:baseline; justify-content:space-between;
    margin-bottom:40px; gap:20px; flex-wrap:wrap;
  }
  .section-head h2{
    font-family:'Fraunces', serif; font-weight:600; font-size:34px;
  }
  .section-head .tag{
    font-family:'IBM Plex Mono', monospace; font-size:12.5px; color:var(--teal);
    border:1px solid var(--rule); padding:5px 10px; border-radius:2px;
  }

  /* ---------- EDUCATION ---------- */
  .edu-list{ display:flex; flex-direction:column; gap:0; }
  .edu-row{
    display:grid; grid-template-columns: 140px 1fr; gap:24px;
    padding:22px 0; border-top:1px solid var(--rule);
  }
  .edu-row:last-child{ border-bottom:1px solid var(--rule); }
  .edu-status{ font-family:'IBM Plex Mono', monospace; font-size:12.5px; color:var(--mustard); text-transform:uppercase; letter-spacing:0.05em; padding-top:3px;}
  .edu-degree{ font-family:'Fraunces', serif; font-size:22px; margin-bottom:4px; }
  .edu-school{ font-size:14.5px; opacity:0.7; }

  /* ---------- SKILLS ---------- */
  .skills-grid{
    display:grid; grid-template-columns:repeat(3, 1fr); gap:1px;
    background:var(--rule); border:1px solid var(--rule);
  }
  .skill-card{ background:var(--paper); padding:26px 24px; }
  .skill-card h3{
    font-family:'IBM Plex Mono', monospace; font-size:12.5px;
    text-transform:uppercase; letter-spacing:0.06em; color:var(--teal);
    margin-bottom:14px;
  }
  .skill-card ul{ list-style:none; display:flex; flex-direction:column; gap:8px; }
  .skill-card li{ font-size:14.5px; padding-left:16px; position:relative; }
  .skill-card li::before{
    content:"—"; position:absolute; left:0; color:var(--mustard);
  }

  /* ---------- PROJECTS ---------- */
  .project{
    display:grid; grid-template-columns: 1fr 1.6fr; gap:36px;
    padding:36px 0; border-top:1px solid var(--rule);
  }
  .project:last-child{ border-bottom:1px solid var(--rule); }
  .project-kicker{
    font-family:'IBM Plex Mono', monospace; font-size:12px; color:var(--mustard);
    text-transform:uppercase; letter-spacing:0.06em; margin-bottom:10px; display:block;
  }
  .project h3{ font-family:'Fraunces', serif; font-size:26px; font-weight:600; line-height:1.15; }
  .project ul{ list-style:none; display:flex; flex-direction:column; gap:10px; }
  .project li{ font-size:15px; padding-left:20px; position:relative; }
  .project li::before{
    content:"›"; position:absolute; left:0; color:var(--teal); font-weight:600;
  }

  /* ---------- INTERESTS ---------- */
  .interests-strip{
    display:flex; flex-wrap:wrap; gap:14px;
  }
  .chip{
    font-family:'IBM Plex Mono', monospace; font-size:13px;
    border:1px solid var(--rule); padding:10px 16px; border-radius:999px;
    background:var(--parchment);
  }

  /* ---------- FOOTER / CONTACT ---------- */
  footer{
    padding:80px 0 60px; background:var(--teal); color:var(--parchment);
  }
  footer .wrap{ display:flex; flex-direction:column; gap:22px; }
  footer h2{
    font-family:'Fraunces', serif; font-style:italic; font-weight:500;
    font-size:clamp(30px, 5vw, 48px); max-width:680px; line-height:1.1;
  }
  .footer-links{ display:flex; gap:30px; flex-wrap:wrap; margin-top:8px; }
  .footer-links a{
    font-family:'IBM Plex Mono', monospace; font-size:14px;
    text-decoration:none; border-bottom:1px solid rgba(241,237,227,0.35);
    padding-bottom:3px;
  }
  .footer-links a:hover{ border-color:var(--mustard); }
  .footer-note{ font-size:12.5px; opacity:0.55; margin-top:24px; font-family:'IBM Plex Mono', monospace;}

  /* ---------- RESPONSIVE ---------- */
  @media (max-width:760px){
    .hero-split{ grid-template-columns:1fr; }
    .hero-cell + .hero-cell{ border-left:none; border-top:1px solid var(--rule); }
    .skills-grid{ grid-template-columns:1fr; }
    .project{ grid-template-columns:1fr; gap:14px; }
    .edu-row{ grid-template-columns:1fr; gap:6px; }
    .nav-links{ display:none; }
  }

  @media (prefers-reduced-motion: reduce){
    html{ scroll-behavior:auto; }
  }
</style>
</head>
